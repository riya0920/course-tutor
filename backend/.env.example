# Copy to .env and fill in. With NO keys set, the app runs in offline "mock
# mode": deterministic canned tutor/quiz/grade responses + hashing-based
# retrieval, so the whole thing works end-to-end with zero setup.

# --- Anthropic (tutor, quizzes, grading, prompt caching) ---
ANTHROPIC_API_KEY=
# Opus 5 by default; set to claude-sonnet-5 to trade quality for cost.
TUTOR_MODEL=claude-opus-5

# --- OpenAI (optional: fine-tuning component only) ---
OPENAI_API_KEY=
OPENAI_BASE_MODEL=gpt-4o-mini
FINETUNED_MODEL=

# --- Retrieval ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_TOKENS=320
CHUNK_OVERLAP=60
RETRIEVE_K=5
GROUNDING_FLOOR=0.35

# --- Guardrails master switch (eval harness flips this for OFF/ON baselines) ---
GUARDRAILS_ENABLED=true

# --- CORS (add your deployed frontend origin here) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
